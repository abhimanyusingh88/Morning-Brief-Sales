{
  "name": "morning-brief",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "tsx scripts/dev-db.ts",
    "db:reset": "rm -rf .data && tsx scripts/dev-db.ts",
    "brief": "npm run live:refresh",
    "shots": "tsx scripts/screens.ts",
    "clients:import": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/import-clients.ts",
    "live:refresh": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/live-refresh.ts",
    "schedule:setup": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/setup-schedule.ts",
    "demo:check": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/demo-check.ts",
    "brief:email": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/send-brief.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@upstash/qstash": "^2.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.52.0",
    "next": "16.3.8",
    "node-cron": "^4.6.0",
    "openai": "^7.27.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.64.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
