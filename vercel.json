{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 60
    },
    "src/app/api/live/work/route.ts": {
      "maxDuration": 240
    },
    "src/app/api/live/refresh/route.ts": {
      "maxDuration": 60
    },
    "src/app/api/live/effects/route.ts": {
      "maxDuration": 150
    }
  },
  "crons": [
    {
      "path": "/api/live/work",
      "schedule": "15 13 * * 1-5"
    }
  ]
}
