# Server-only secrets. Never commit real values.
DATABASE_URL=
SESSION_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Production sign-in: mapped Supabase users OR private pilot email/access-code login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
DEMO_ACCESS_CODE=

# Production scheduler. Set APP_URL to the deployed HTTPS origin before schedule:setup.
APP_URL=
QSTASH_URL=https://qstash.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public feeds refresh on five-minute slots.
# AI discovery is eligible only every configured interval, and only if feeds are sparse.
NEWS_REFRESH_MINUTES=30
NEWS_DAILY_CALL_LIMIT=48

# Optional authorized full-text HTML sources.
# Exact comma-separated hosts with confirmed full-text redistribution rights.
# Empty means original articles are NOT republished. RSS access is not a full-text license.
# The independent source network allowlist must also allow these hosts.
NEWS_FULL_TEXT_HOSTS=

# Optional local embedded database. It starts empty; explicitly import the workbook.
DEV_DB=
